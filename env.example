# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# PostgreSQL Configuration
DATABASE_URL=postgresql://task_bot_user:your_password_here@localhost:5432/task_bot

# Webhook Configuration (optional - if not set, bot will use polling)
# WEBHOOK_URL=https://yourdomain.com
# WEBHOOK_PATH=/task-bot  # Optional, defaults to /task-bot
# Note: Webhook secret is auto-generated for security - no configuration needed
